# ============================================================================
# Universal Sompo Evidence Finder — local configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` in the repository root and fill in the values you
# have. `.env` is gitignored and must never be committed.
#
#     cp .env.example .env
#
# Every key here is OPTIONAL. With none of them set the app still runs and
# still searches live: Google News RSS in thirteen Indian-language editions,
# Bing News, Bing Web and Mojeek all work without any credential.
# ============================================================================

# --- Facebook and Instagram evidence discovery ------------------------------
# Required for social discovery, and for real Google SERP results.
#
# Neither platform exposes post content to anonymous crawlers, so the free
# engines return only login walls. A paid SERP index is the only way to reach
# publicly indexed posts. Get a key at https://serper.dev (free tier available).
#
# Without this the app behaves exactly as before: news and web search run
# normally, and the Search Lab states plainly that the social tier was not
# searched rather than leaving it silently empty.
SERPER_API_KEY=

# --- Alternative Google provider (used only if SERPER_API_KEY is absent) -----
# Google Programmable Search: https://programmablesearchengine.google.com
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# --- Optional LLM-assisted parsing ------------------------------------------
GEMINI_API_KEY=

# --- Optional Python backend (only needed if you run `python run.py`) -------
PORT=8000
HOST=0.0.0.0
